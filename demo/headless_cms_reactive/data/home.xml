<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="home2" name="Home">
            <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure">
                    <section>
                        <div class="container">
                            <h1>About us</h1>

                            <div class="row">
                                <div class="col-6 text-center">
                                    <h2>...</h2>
                                </div>
                                <div class="col-6 text-center">
                                    <h2>...</h2>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <data noupdate="0">
        <!-- Default pagese -->
        <record id="homepage2_page" model="website.page">
            <field name="is_published">True</field>
            <field name="url">/home2</field>
            <field name="view_id" ref="home2"/>
            <field name="track">True</field>
            <field name="website_meta_description">This is the homepage of the CMS website</field>
        </record>

        <!-- Default Menu to store module menus for new website -->
        <record id="menu_home" model="website.menu">
            <field name="name">Home 2</field>
            <field name="url">/home2</field>
            <field name="page_id" ref="headless_cms.homepage2_page"/>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">30</field>
        </record>

    </data>

</odoo>
